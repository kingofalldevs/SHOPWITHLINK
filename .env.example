# Copy this file to .env and fill in your values.
# Do not commit .env to version control.

SECRET_KEY=your-secret-key-change-in-production

# Optional: override database (default is SQLite in instance/shopwithlink.db)
# DATABASE_URL=sqlite:///instance/shopwithlink.db

# Paystack Ghana – GHS (get keys from https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# SendGrid SMTP – email verification (https://docs.sendgrid.com/for-developers/sending-email/getting-started-smtp)
# Host: smtp.sendgrid.net, Port: 587, Username: apikey, Password: your API key
# Get API key: https://app.sendgrid.com/settings/api_keys
# SENDGRID_FROM_EMAIL must be verified: SendGrid → Settings → Sender Authentication
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Shop With Link
